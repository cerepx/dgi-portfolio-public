# Regenerated by every /audit-live run. Never a source of truth, and a
# committed snapshot invites auditing a stale one — the exact failure the
# command was built to avoid.
sheet-snapshot.json
sheet-snapshot-*.json
live-audit.xlsx
flex-dividends.json

# Python bytecode. See README -> Development: always run python3 -B, since
# the agent sandbox cannot delete these from the mounted folder.
__pycache__/
*.pyc
*.pyo

# macOS
.DS_Store
# Version-stamped copies delivered into a conversation. The canonical
# artifact is dgi-portfolio/dgi-portfolio.plugin, which IS tracked.
dgi-portfolio-*.plugin

# Public export: personal data and private work state never belong here.
Portofoliu.xlsx
*.xlsx
stocks-*.csv
changesets/
BACKLOG.md
CLAUDE.md
tools/
